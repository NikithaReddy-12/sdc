@import 'tailwindcss';
@config '../tailwind.config.ts';
:root{--ink:#0b1720;--paper:#f4f5ef;--green:#68e36d;--cyan:#51d9d0;--muted:#70808a;--line:rgba(11,23,32,.13)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}button,a{font:inherit}button{cursor:pointer}h1,h2,h3,h4{font-family:'Space Grotesk',Inter,sans-serif}::selection{background:#68e36d;color:#08120d}
.site-shell{overflow:hidden}.site-nav{position:fixed;z-index:50;top:0;left:0;right:0;height:82px;padding:0 clamp(18px,4vw,64px);display:flex;align-items:center;justify-content:space-between;background:rgba(244,245,239,.82);backdrop-filter:blur(18px);border-bottom:1px solid rgba(11,23,32,.08)}.brand{display:flex;align-items:center;gap:12px;border:0;background:none;color:var(--ink);text-align:left}.brand img{width:50px;height:50px;object-fit:contain;border-radius:50%}.brand span{display:flex;flex-direction:column}.brand b{font-size:16px;letter-spacing:.08em}.brand small{font-size:9px;letter-spacing:.18em;color:#75818a;margin-top:3px}.site-nav nav{display:flex;gap:clamp(14px,2.2vw,32px)}.site-nav nav button,.mobile-menu button{border:0;background:none;color:#53616a;text-transform:uppercase;letter-spacing:.12em;font-size:11px}.site-nav nav button:hover,.mobile-menu button:hover{color:#111}.nav-actions{display:flex;gap:9px}.admin-nav,.join-nav{padding:11px 16px;text-transform:uppercase;letter-spacing:.11em;font-size:10px;background:transparent}.admin-nav{border:1px solid #9ca8ac}.join-nav{border:1px solid #2f8e4a;background:#68e36d;color:#08210f}.menu-btn{display:none;border:1px solid #c8cfce;background:white;width:42px;height:40px}.mobile-menu{display:none}
.home-hero{position:relative;min-height:100svh;padding:140px clamp(20px,7vw,110px) 44px;background:#09151a;color:white;overflow:hidden}.hero-grid{position:absolute;inset:0;opacity:.18;background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:70px 70px;mask-image:linear-gradient(to bottom,black,transparent 85%)}.hero-orb{position:absolute;border-radius:50%;filter:blur(5px);opacity:.7}.hero-orb-a{width:420px;height:420px;right:4%;top:13%;background:radial-gradient(circle,rgba(104,227,109,.2),transparent 65%);animation:float 8s ease-in-out infinite}.hero-orb-b{width:330px;height:330px;left:-100px;bottom:-80px;background:radial-gradient(circle,rgba(81,217,208,.16),transparent 68%);animation:float 10s ease-in-out infinite reverse}.hero-inner{position:relative;z-index:2;max-width:1250px;margin:auto;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:8vw;min-height:calc(100svh - 180px)}.eyebrow,.section-kicker{font-size:10px;letter-spacing:.22em;text-transform:uppercase}.eyebrow{color:#a7b4b9;margin-bottom:24px}.hero-copy h1{font-size:clamp(4rem,8vw,8rem);line-height:.9;letter-spacing:-.06em;margin:0;max-width:780px}.hero-copy h1 span{color:var(--green);font-style:italic}.hero-lead{font-size:clamp(17px,2vw,23px);line-height:1.55;color:#aab8bc;max-width:670px;margin:28px 0}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;gap:14px;padding:15px 21px;text-decoration:none;text-transform:uppercase;letter-spacing:.14em;font-size:10px;font-weight:700}.btn-primary{background:var(--green);color:#09200e;border:1px solid var(--green)}.btn-ghost{color:white;border:1px solid rgba(255,255,255,.24)}.hero-logo-card{position:relative;display:flex;align-items:center;justify-content:center;min-height:530px}.hero-logo-card img{position:relative;z-index:3;width:min(410px,70vw);filter:drop-shadow(0 25px 45px rgba(0,0,0,.45));animation:logoFloat 5s ease-in-out infinite}.hero-logo-card p{position:absolute;z-index:4;bottom:45px;letter-spacing:.3em;font-size:10px;color:#b9c6c8}.logo-glow{position:absolute;width:430px;height:430px;border-radius:50%;background:radial-gradient(circle,rgba(104,227,109,.2),rgba(81,217,208,.06) 40%,transparent 70%);filter:blur(16px)}.logo-ring{position:absolute;border-radius:50%;border:1px solid rgba(104,227,109,.22)}.logo-ring-one{width:480px;height:480px;animation:spin 18s linear infinite}.logo-ring-two{width:390px;height:390px;border-color:rgba(81,217,208,.2);border-style:dashed;animation:spin 14s linear infinite reverse}.hero-bottom{position:absolute;z-index:3;left:clamp(20px,7vw,110px);right:clamp(20px,7vw,110px);bottom:30px;display:flex;justify-content:space-between;color:#74878b;font-size:9px;letter-spacing:.16em;text-transform:uppercase}.section{padding:120px clamp(20px,7vw,110px)}.section-light{background:var(--paper)}.section-dark{background:#0a171c;color:white}.section-container{max-width:1250px;margin:auto}.section-kicker{color:#4f7f6e;margin:0 0 35px}.section-dark .section-kicker{color:var(--green)}.split-intro,.section-heading-row{display:grid;grid-template-columns:1.1fr .9fr;gap:8vw}.split-intro h2,.section-heading-row h2,.join-inner h2,.contact-section h2{font-size:clamp(3rem,6vw,6.5rem);line-height:.93;letter-spacing:-.055em;margin:0}.split-intro h2 em,.section-heading-row h2 em,.join-inner h2 em,.contact-section h2 em{font-style:italic;color:#4b9f68}.large-copy{font-size:clamp(18px,2vw,26px);line-height:1.55;margin:0 0 22px}.muted-copy,.section-heading-row>p{color:var(--muted);line-height:1.75;font-size:15px}.stats-row{max-width:1250px;margin:80px auto 0;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.stat-card{padding:28px 22px;border-right:1px solid var(--line)}.stat-card:last-child{border:0}.stat-card strong{font-family:'Space Grotesk';font-size:46px;display:block}.stat-card strong small{font-size:22px;color:#4b9f68}.stat-card span{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.12em}.stat-card p{color:var(--muted);font-size:12px;line-height:1.5}.pillars-grid,.event-grid,.team-grid,.legacy-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:65px}.pillar-card{border:1px solid rgba(255,255,255,.12);padding:28px;min-height:300px;background:rgba(255,255,255,.025);transition:.35s}.pillar-card:hover{transform:translateY(-8px);border-color:rgba(104,227,109,.5);background:rgba(104,227,109,.04)}.pillar-card>span{color:var(--green);font-size:10px;letter-spacing:.15em}.pillar-card h3{font-size:28px;margin:55px 0 16px}.pillar-card p{color:#9caeb3;line-height:1.65;font-size:13px}.pillar-card ul{padding:0;margin:22px 0 0;list-style:none;color:#d7e0e1;font-size:11px;line-height:2}.pillar-card li::before{content:'— ';color:var(--green)}.event-grid{grid-template-columns:repeat(3,1fr)}.event-card{border-top:3px solid var(--green);padding:26px;background:white;box-shadow:0 10px 30px rgba(11,23,32,.05);transition:.35s}.event-card:hover{transform:translateY(-7px);box-shadow:0 20px 45px rgba(11,23,32,.1)}.event-date{font-size:11px;color:#4d675e;letter-spacing:.12em}.event-type{display:inline-block;margin-top:22px;font-size:9px;letter-spacing:.14em;color:#3e8f60}.event-card h3{font-size:25px;line-height:1.05;margin:10px 0 14px}.event-card p{color:var(--muted);font-size:13px;line-height:1.65;min-height:88px}.event-meta{border-top:1px solid var(--line);padding-top:14px;display:flex;justify-content:space-between;gap:10px;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:#61716f}.section-link{margin-top:28px}.section-link a{color:#27764a;text-decoration:none;font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.14em}.team-grid{grid-template-columns:repeat(3,1fr)}.member-card{border:1px solid rgba(255,255,255,.1);background:#0e2026;transition:.35s;overflow:hidden}.member-card:hover{transform:translateY(-6px)}.member-photo{height:290px;background:linear-gradient(145deg,#173c35,#0c1a1f);display:flex;align-items:center;justify-content:center;overflow:hidden}.member-photo img{width:100%;height:100%;object-fit:cover;transition:.5s}.member-card:hover img{transform:scale(1.04)}.member-photo span{font-family:'Space Grotesk';font-size:64px;color:var(--green)}.member-info{padding:20px}.member-info>span{font-size:9px;color:var(--green);letter-spacing:.16em}.member-info h3{margin:7px 0 4px;font-size:22px}.member-info p{margin:0;color:#91a2a6;font-size:12px}.archive-list{margin-top:55px;border-top:1px solid var(--line)}.archive-row{display:grid;grid-template-columns:100px 1fr 260px;gap:30px;padding:28px 0;border-bottom:1px solid var(--line);align-items:start}.archive-row>span{font-family:'Space Grotesk';font-size:28px;color:#4b9f68}.archive-row small{font-size:9px;letter-spacing:.15em;color:#6b7a77}.archive-row h3{margin:5px 0 7px;font-size:25px}.archive-row p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.archive-row strong{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#557066}.legacy-grid{grid-template-columns:repeat(2,1fr)}.legacy-card{padding:34px;border:1px solid rgba(255,255,255,.11);background:rgba(255,255,255,.025)}.legacy-card>span{color:var(--green);font-size:10px;letter-spacing:.16em}.legacy-card h3{font-size:32px;margin:15px 0 8px}.legacy-card h4{font-size:15px;color:#b8c7ca;font-weight:500}.legacy-card p{color:#92a4a8;font-size:13px;line-height:1.7}.tag-row{display:flex;flex-wrap:wrap;gap:7px}.tag-row span{border:1px solid rgba(255,255,255,.12);padding:7px 9px;color:#b7c7c8;font-size:9px;letter-spacing:.08em}.join-section{background:#68e36d;color:#09200e;padding:120px clamp(20px,7vw,110px)}.join-inner{max-width:1250px;margin:auto}.join-inner p:not(.section-kicker){max-width:600px;font-size:18px;line-height:1.6;margin:28px 0}.join-section .btn-primary{background:#09200e;color:#fff;border-color:#09200e}.contact-section{background:#071116;color:white;padding:110px clamp(20px,7vw,110px);display:grid;grid-template-columns:1fr 1fr;gap:10vw}.contact-details{align-self:end;color:#9aabad;line-height:1.8}.contact-details a{color:var(--green)}
@keyframes spin{to{transform:rotate(360deg)}}@keyframes float{50%{transform:translateY(-20px)}}@keyframes logoFloat{50%{transform:translateY(-10px)}}
@media(max-width:1000px){.site-nav nav{display:none}.menu-btn{display:block}.mobile-menu{position:absolute;top:82px;left:0;right:0;background:rgba(244,245,239,.98);padding:20px;display:grid;gap:14px;border-bottom:1px solid var(--line)}.mobile-menu button{text-align:left;padding:10px}.hero-inner,.split-intro,.section-heading-row,.contact-section{grid-template-columns:1fr}.hero-inner{gap:30px}.hero-logo-card{min-height:400px}.pillars-grid{grid-template-columns:repeat(2,1fr)}.stats-row{grid-template-columns:repeat(2,1fr)}.stat-card:nth-child(2){border-right:0}.event-grid,.team-grid{grid-template-columns:repeat(2,1fr)}.archive-row{grid-template-columns:70px 1fr}.archive-row strong{display:none}.hero-bottom{display:none}.nav-actions .admin-nav,.nav-actions .join-nav{display:none}}
@media(max-width:640px){.site-nav{height:72px}.brand img{width:42px;height:42px}.brand b{font-size:13px}.brand small{font-size:8px}.home-hero{padding-top:115px}.hero-copy h1{font-size:3.5rem}.hero-logo-card{min-height:350px}.hero-logo-card img{width:270px}.logo-ring-one{width:330px;height:330px}.logo-ring-two{width:270px;height:270px}.section{padding:82px 20px}.stats-row,.pillars-grid,.event-grid,.team-grid,.legacy-grid{grid-template-columns:1fr}.stat-card{border-right:0;border-bottom:1px solid var(--line)}.split-intro h2,.section-heading-row h2,.join-inner h2,.contact-section h2{font-size:3.2rem}.archive-row{grid-template-columns:1fr}.archive-row>span{font-size:22px}.hero-actions{flex-direction:column;align-items:flex-start}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;transition-duration:.001ms!important;scroll-behavior:auto!important}}
.site-footer{background:#071116;color:#dce5e5;padding:70px clamp(20px,7vw,110px) 25px}.footer-inner{max-width:1250px;margin:auto;display:grid;grid-template-columns:1.4fr .6fr 1fr;gap:8vw}.footer-brand{display:flex;align-items:center;gap:12px}.footer-brand img{width:48px;height:48px;object-fit:contain;border-radius:50%}.footer-brand b{display:block;font-family:'Space Grotesk';letter-spacing:.08em}.footer-brand small{font-size:8px;letter-spacing:.15em;color:#819195}.site-footer p{color:#849598;font-size:12px;line-height:1.7;max-width:420px}.footer-links{display:flex;flex-direction:column;gap:9px}.footer-links span{font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--green);margin-bottom:8px}.footer-links a{color:#aab8ba;text-decoration:none;font-size:12px}.footer-links a:hover{color:var(--green)}.footer-bottom{max-width:1250px;margin:55px auto 0;padding-top:18px;border-top:1px solid rgba(255,255,255,.1);display:flex;justify-content:space-between;color:#66777a;font-size:10px}.footer-bottom a{color:#9aacaf;text-decoration:none}.admin-input{width:100%;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.035);color:#eef5f5;padding:11px 12px;outline:none}.admin-input:focus{border-color:var(--green)}.admin-input::placeholder{color:#718083}.admin-input option{background:#0d1b20;color:white}@media(max-width:800px){.footer-inner{grid-template-columns:1fr 1fr}.footer-inner>div:first-child{grid-column:1/-1}}@media(max-width:560px){.footer-inner{grid-template-columns:1fr}.footer-bottom{flex-direction:column;gap:10px}}

